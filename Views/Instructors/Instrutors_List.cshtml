@model IEnumerable<university_Project.Models.InstructorViewModel>



@{
    ViewData["Title"] = "Instructors List";
}
<a href="/Instructors/Create" class="btn btn-primary mb-3">Add New Instructor</a>
<div class="container-fluid py-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h1 class="h3 mb-0 text-center">Instructors List</h1>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th class="text-center">Id</th>
                            <th>Name</th>
                            <th class="text-right">Salary</th>
                            <th>Address</th>
                            <th class="text-center">Course Name</th>
                            <th class="text-center">Department Name</th>
                            <th class="text-center">Action</th>
                            
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var instructor in Model)
                        {
                            <tr>
                                <td class="text-center">@instructor.ID</td>
                                <td>@instructor.Name</td>
                                <td class="text-right">@string.Format("{0:C}", instructor.Salary)</td>
                                <td>@instructor.Address</td>
                               
                                <td class="text-center">@instructor.CourseName </td>
                                <td class="text-center">@instructor.DepartmentName</td>
                                <td>
                                    <a href="/Instructors/Edit/@instructor.ID " class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@instructor.ID" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this course?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-light">
            <div class="text-muted text-center">
                Total Instructors: @Model.Count()
            </div>
        </div>
    </div>
</div>

<style>
    .table thead th {
        vertical-align: middle;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    .table tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
        transition: all 0.2s ease;
    }

    .card {
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .card-header {
        padding: 1.25rem 1.5rem;
    }
</style>