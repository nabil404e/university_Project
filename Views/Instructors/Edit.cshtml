@model university_Project.Models.Cls_Instructor

@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="container py-4">
    <h1 class="mb-4 text-primary fw-bold">
        <i class="bi bi-pencil-square"></i> Edit Instructor
    </h1>

    <form asp-action="Edit" asp-route-id="@Model.ID" method="post" class="needs-validation" novalidate>


        <!-- Personal Info -->
        <div class="card shadow-sm mb-4">   
            <div class="card-header bg-primary text-white fw-bold">
                Personal Information
            </div>
            <div class="card-body">
                <div class="mb-3">
                    @Html.HiddenFor(model => model.ID) <!-- MUST be before Name field -->
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter course name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="Image_URL" class="form-label fw-semibold"></label>
                    <input asp-for="Image_URL" class="form-control" placeholder="Enter image URL" />
                    <span asp-validation-for="Image_URL" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold"></label>
                    <input asp-for="Address" class="form-control" placeholder="Enter address" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Job Details -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white fw-bold">
                Job Details
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Salary" class="form-label fw-semibold"></label>
                    <input asp-for="Salary" class="form-control" type="number" step="0.01" placeholder="Enter salary" />
                    <span asp-validation-for="Salary" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Depart_ID" class="form-label fw-semibold"></label>
                    <select asp-for="Depart_ID" class="form-select" asp-items="ViewBag.Departments">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="Depart_ID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CRS_ID" class="form-label fw-semibold"></label>
                    <select asp-for="CRS_ID" class="form-select" asp-items="ViewBag.Courses">
                        <option value="">-- Select Course --</option>
                    </select>
                    <span asp-validation-for="CRS_ID" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save"></i> Save
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
