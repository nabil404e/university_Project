@using university_Project.ViewModel
@model IEnumerable<TrainerViewModel>

@{
    ViewData["Title"] = "Trainers Management";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.1/font/bootstrap-icons.min.css" rel="stylesheet" />

<div class="container py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">
            <i class="bi bi-people-fill me-2"></i>Trainers Management
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Add New Trainer
        </a>
    </div>

    <!-- Search Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-search me-2"></i>Find Trainer
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Show_Results" method="get" class="row g-3">
                <div class="col-md-8">
                    <label for="trainerId" class="form-label">Trainer ID</label>
                    <input type="number" id="trainerId" name="id"
                           class="form-control" placeholder="Enter Trainer ID"
                           min="1" required />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-search me-2"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Trainers Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">ID</th>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Department</th>
                            <th>Course</th>
                            <th class="text-center">Degree</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var trainer in Model)
                            {
                                <tr>
                                    <td class="text-center">@trainer.ID</td>
                                    <td>@trainer.Name</td>
                                    <td>@trainer.Address</td>
                                    <td>@trainer.Department?.Name</td>
                                    <td>@trainer.Course?.Name</td>
                                    <td class="text-center">
                                        @if (trainer.Result != null && trainer.Result.Degree > 0)
                                        {
                                            <span class="badge @(trainer.Result.Degree >= 60 ? "bg-success" : "bg-warning")">
                                                @trainer.Result.Degree
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No Result</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@trainer.ID"
                                               class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@trainer.ID"
                                               class="btn btn-sm btn-outline-danger" title="Delete"
                                               onclick="return confirm('Are you sure you want to delete this trainer?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                            <a asp-action="Show_Results" asp-route-id="@trainer.ID"
                                               class="btn btn-sm btn-outline-info" title="View Results">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="alert alert-info mb-0">
                                        <i class="bi bi-info-circle me-2"></i>No trainers found.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table thead th {
        vertical-align: middle;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    .table tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }

    .card {
        border-radius: 0.5rem;
        overflow: hidden;
        border: none;
    }

    .card-header {
        padding: 1rem 1.5rem;
        background-color: #0d6efd;
    }

    .badge {
        font-size: 0.85em;
        padding: 0.35em 0.65em;
        min-width: 50px;
    }

    .btn-group .btn {
        border-radius: 0.25rem !important;
        margin: 0 2px;
    }
</style>

@section Scripts {
    <script>
        // Client-side form validation
        (function() {
            'use strict';

            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            const forms = document.querySelectorAll('form');

            // Loop over them and prevent submission
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}