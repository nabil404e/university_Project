@using university_Project.ViewModel
@model IEnumerable<TrainerResultViewModel>

@{
    ViewData["Title"] = "Course Results";
}

<div class="container mt-4">
    <h2 class="mb-4">Course Results</h2>

    <!-- Search and Filter Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <form asp-action="Index" method="get" class="form-inline">
                        <div class="input-group">
                            <input type="number" name="traineeId" class="form-control" placeholder="Search by Trainee ID" />
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-md-6">
                    <form asp-action="Index" method="get" class="form-inline float-md-end">
                        <div class="input-group">
                            <input type="number" name="courseId" class="form-control" placeholder="Search by Course ID" />
                            <button type="submit" class="btn btn-secondary">
                                <i class="bi bi-filter"></i> Filter
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Table -->
    <!-- Results Table -->
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>ID</th>
                            <th>Trainer Name</th>
                            <th>Course</th>
                            <th>Degree</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td>@result.TrainerID</td>
                                    <td>@result.TrainerName</td>
                                    <td>@result.CourseName</td>
                                    <td>@result.Degree</td>
                                    <td>
                                        @if (result.Status == "Pass")
                                        {
                                            <span class="badge bg-success">Pass</span>
                                        }
                                        else if (result.Status == "Fail")
                                        {
                                            <span class="badge bg-danger">Fail</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@result.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@result.TrainerID" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@result.ID" class="btn btn-danger btn-sm"
                                               onclick="return confirm('Are you sure you want to delete this course?');">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                         
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    <i class="bi bi-info-circle"></i> No results found. Would you like to add some?
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Result
        </a>
    </div>
</div>
