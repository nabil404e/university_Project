@model university_Project.Models.Cls_Course
@{
    ViewData["Title"] = "Create Course";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

<style>
    body {
        background: #f8f9fa;
    }

    .card {
        max-width: 600px;
        margin: auto;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        border-radius: 12px;
    }

    .card-header {
        background: #007bff;
        color: white;
        font-weight: 600;
        font-size: 1.5rem;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        text-align: center;
    }

    .form-label {
        font-weight: 500;
    }

    .loading-spinner {
        display: none;
        width: 1.5rem;
        height: 1.5rem;
        border: 0.25em solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border .75s linear infinite;
    }

    @@keyframes spinner-border {
        to {
            transform: rotate(360deg);
        }
    }

    .is-invalid {
        border-color: #dc3545;
    }

    .is-valid {
        border-color: #28a745;
    }

    .validation-message {
        color: #dc3545;
        font-size: 0.875em;
        margin-top: 0.25rem;
    }

    .checking-availability {
        color: #6c757d;
        font-size: 0.875em;
        margin-top: 0.25rem;
    }
</style>

<div class="container mt-5">
    <div class="card p-4">
        <div class="card-header">
            Add New Course
        </div>

        <form id="courseForm" method="post" asp-action="Create" class="needs-validation" novalidate>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control"
                       required
                       data-val="true"
                       data-val-required="The Course Name is required."
                       data-val-unique="Course name already exists."
                       data-val-unique-url="@Url.Action("IS_Valid_Name", "Course")" />
                <span asp-validation-for="Name" class="validation-message"></span>
                <div id="nameAvailability" class="checking-availability" style="display: none;">
                    <i class="bi bi-hourglass"></i> Checking availability...
                </div>
                <div class="invalid-feedback">Please enter a unique course name.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Degree" class="form-label"></label>
                <input asp-for="Degree" class="form-control"
                       type="number" step="0.1" min="0.1"
                       required
                       data-val="true"
                       data-val-required="The Degree is required." />
                <span asp-validation-for="Degree" class="validation-message"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Min_Degree" class="form-label"></label>
                <input asp-for="Min_Degree" class="form-control"
                       type="number" step="0.1" min="0.1"
                       required
                       data-val="true"
                       data-val-required="The Minimum Degree is required."
                       data-val-lessthan="Minimum degree must be less than total degree."
                       data-val-lessthan-other="Degree" />
                <span asp-validation-for="Min_Degree" class="validation-message"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Depart_ID" class="form-label"></label>
                <select asp-for="Depart_ID" class="form-select" asp-items="ViewBag.Departments" required>
                    <option value="">-- Select Department --</option>
                </select>
                <span asp-validation-for="Depart_ID" class="validation-message"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary shadow-sm" id="submitBtn">
                    <i class="bi bi-save me-1"></i> <span id="submitText">Save</span>
                    <span id="submitSpinner" class="loading-spinner ms-2"></span>
                </button>
                <a asp-action="Index" class="btn btn-secondary shadow-sm">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        $(document).ready(function () {
            // Custom validator for unique course name
            $.validator.addMethod("unique", function(value, element, params) {
                var url = $(element).data("val-unique-url");
                var result = true;

                // Skip if empty (handled by required validator)
                if (!value) return true;

                // Show checking message
                $("#nameAvailability").show();

                // Make synchronous AJAX call for validation
                $.ajax({
                    url: url,
                    type: "GET",
                    data: { Name: value, ID: 0 }, // ID=0 for new course
                    async: false,
                    success: function(data) {
                        result = data;
                        $("#nameAvailability").hide();
                    },
                    error: function() {
                        result = false;
                        $("#nameAvailability").hide();
                    }
                });

                return result;
            });

            // Attach the adapter for the unique validator
            $.validator.unobtrusive.adapters.add("unique", [], function(options) {
                options.rules["unique"] = true;
                options.messages["unique"] = options.message;
            });

            // Configure validation
            $.validator.setDefaults({
                onfocusout: function(element) {
                    $(element).valid();
                },
                errorClass: "is-invalid",
                validClass: "is-valid",
                errorElement: "span",
                errorPlacement: function(error, element) {
                    error.addClass("validation-message");
                    error.insertAfter(element);
                },
                highlight: function(element, errorClass, validClass) {
                    $(element).addClass(errorClass).removeClass(validClass);
                },
                unhighlight: function(element, errorClass, validClass) {
                    $(element).removeClass(errorClass).addClass(validClass);
                }
            });

            // Initialize form validation
            var validator = $("#courseForm").validate({
                submitHandler: function(form) {
                    // Handle form submission
                    $('#submitBtn').prop('disabled', true);
                    $('#submitText').text('Saving...');
                    $('#submitSpinner').show();

                    $.ajax({
                        url: $(form).attr('action'),
                        type: $(form).attr('method'),
                        data: $(form).serialize(),
                        success: function(response) {
                            if (response.success) {
                                toastr.success('Course created successfully!');
                                setTimeout(function() {
                                    window.location.href = '@Url.Action("Index", "Course")';
                                }, 1500);
                            } else {
                                if (response.errors) {
                                    // Display server-side validation errors
                                    validator.showErrors(response.errors);
                                } else {
                                    toastr.error(response.message || 'An error occurred while creating the course.');
                                }
                                $('#submitBtn').prop('disabled', false);
                                $('#submitText').text('Save');
                                $('#submitSpinner').hide();
                            }
                        },
                        error: function(xhr) {
                            toastr.error('An error occurred while creating the course.');
                            $('#submitBtn').prop('disabled', false);
                            $('#submitText').text('Save');
                            $('#submitSpinner').hide();
                        }
                    });
                }
            });

            // Toastr configuration
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "timeOut": "5000",
                "extendedTimeOut": "1000"
            };
        });
    </script>
}