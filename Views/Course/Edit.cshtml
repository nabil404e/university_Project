@model university_Project.Models.Cls_Course
@{
    ViewData["Title"] = "Edit";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" rel="stylesheet" />

<style>
    body {
        background: #0000;
    }

    .card {
        max-width: 600px;
        margin: auto;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        border-radius: 12px;
    }

    .card-header {
        background: #007bff;
        color: white;
        font-weight: 600;
        font-size: 1.5rem;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        text-align: center;
    }

    .form-label {
        font-weight: 500;
    }

    .btn-primary {
        transition: background-color 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .btn-secondary:hover {
        background-color: #5a6268;
    }

    .form-control:focus {
        box-shadow: 0 0 5px #007bff;
        border-color: #007bff;
    }
</style>

<div class="container mt-5">
    <div class="card p-4">
        <div class="card-header">
            Edit Course
        </div>

        <form asp-action="Edit" asp-route-id="@Model.ID" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                @Html.HiddenFor(model => model.ID)

                <label asp-for="Name" class="form-label"></label>
                <input class="form-control" asp-for="Name" required />
                <div class="invalid-feedback">
                    Please enter the course name.
                </div>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Degree" class="form-label"></label>
                <input class="form-control" asp-for="Degree" type="number" min="0" required />
                <div class="invalid-feedback">
                    Please enter a valid degree.
                </div>
                <span asp-validation-for="Degree" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Min_Degree" class="form-label"></label>
                <input class="form-control" asp-for="Min_Degree" type="number" min="0" required />
                <div class="invalid-feedback">
                    Please enter a valid minimum degree.
                </div>
                <span asp-validation-for="Min_Degree" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Depart_ID" class="form-label"></label>
                <select asp-for="Depart_ID" class="form-select" asp-items="ViewBag.Departments" required>
                    <option value="">-- Select Department --</option>
                </select>
                <div class="invalid-feedback">
                    Please select a department.
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary shadow-sm">
                    <i class="bi bi-save me-1"></i> Save
                </button>
                <a asp-action="Index" class="btn btn-secondary shadow-sm">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Bootstrap client-side validation
        (function () {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
