<!DOCTYPE html>
@{
    Layout = null; 
}
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matter Academy - Online Education</title>
    <header>


            <!-- أزرار Home و Sign Out -->
            <div style="margin-top:20px;">
                @* <a asp-action="Index" asp-controller="Home" class="btn">🏠 Home</a> *@
            <a asp-action="Login" asp-controller="Account" class="btn"
                   onclick="return confirm('Are you sure you want to Sign Out?');">
                    🚪 return Login 
                </a>
            </div>
        </div>
    </header>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            line-height: 1.6;
            color: #e5e7eb;
            background: #0f0f23;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 16px; /* ← بدل media خلتها القيمة الصغيرة مباشرة */
        }

        /* Header */
        header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f0f23 100%);
            padding: 60px 0; /* ← القيمة اللي كانت في media */
            text-align: center;
            border-bottom: 1px solid #2d3748;
        }

            header h1 {
                font-size: 2rem; /* ← أصغر حجم (من 480px) */
                font-weight: 800;
                margin-bottom: 16px;
                background: linear-gradient(135deg, #60a5fa, #a78bfa, #f472b6);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            header p {
                font-size: 1rem; /* ← القيمة الأصغر */
                color: #9ca3af;
                max-width: 600px;
                margin: 0 auto;
            }

        /* Navigation */
        nav {
            background: #1a1a2e;
            padding: 20px 0;
            border-bottom: 1px solid #2d3748;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

            nav ul {
                list-style: none;
                display: flex;
                flex-direction: column; /* ← بدل media مباشرة */
                justify-content: center;
                gap: 8px; /* ← الأصغر */
            }

            nav a {
                text-decoration: none;
                color: #d1d5db;
                font-weight: 500;
                padding: 12px 24px;
                border-radius: 8px;
                transition: all 0.3s ease;
                border: 1px solid transparent;
            }

                nav a:hover {
                    background: #2d3748;
                    color: #60a5fa;
                    border-color: #374151;
                }

        /* Main Content */
        main {
            padding: 60px 0; /* ← بدل media */
        }

        section {
            margin-bottom: 80px; /* ← بدل media */
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

            .section-header h2 {
                font-size: 1.75rem; /* ← بدل media */
                font-weight: 700;
                color: #f3f4f6;
                margin-bottom: 16px;
            }

            .section-header p {
                font-size: 1.125rem;
                color: #9ca3af;
                max-width: 700px;
                margin: 0 auto;
            }

        /* Cards */
        .card {
            background: #1a1a2e;
            padding: 32px 24px; /* ← أصغر */
            border-radius: 16px;
            border: 1px solid #2d3748;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .card-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }

            .card-content p {
                font-size: 1.125rem;
                color: #d1d5db;
                margin-bottom: 24px;
                line-height: 1.7;
            }

        /* Grid Layouts */
        .grid-2,
        .grid-3 {
            display: grid;
            grid-template-columns: 1fr; /* ← دايمًا عمود واحد بدل media */
            gap: 20px;
        }

        .grid-item {
            background: #1a1a2e;
            padding: 24px; /* ← أصغر */
            border-radius: 12px;
            border: 1px solid #2d3748;
            transition: all 0.3s ease;
        }

            .grid-item:hover {
                transform: translateY(-4px);
                border-color: #4b5563;
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
            }

            .grid-item h3 {
                font-size: 1.25rem;
                font-weight: 600;
                color: #60a5fa;
                margin-bottom: 12px;
            }

            .grid-item p {
                color: #9ca3af;
                font-size: 0.95rem;
                line-height: 1.6;
            }

        /* Feature Items */
        .feature-item {
            background: #1a1a2e;
            padding: 24px; /* ← أصغر */
            border-radius: 12px;
            border: 1px solid #2d3748;
            text-align: center;
            transition: all 0.3s ease;
        }

            .feature-item:hover {
                transform: translateY(-4px);
                border-color: #4b5563;
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
            }

            .feature-item h3 {
                font-size: 1.125rem;
                color: #a78bfa;
                margin-bottom: 12px;
            }

            .feature-item p {
                color: #9ca3af;
                font-size: 0.9rem;
            }

        /* Contact Items */
        .contact-item {
            background: #1a1a2e;
            padding: 24px; /* ← أصغر */
            border-radius: 12px;
            border: 1px solid #2d3748;
            text-align: center;
            transition: all 0.3s ease;
        }

            .contact-item:hover {
                transform: translateY(-4px);
                border-color: #4b5563;
            }

            .contact-item h3 {
                color: #f472b6;
                margin-bottom: 16px;
                font-size: 1.125rem;
            }

            .contact-item a {
                color: #60a5fa;
                text-decoration: none;
                font-weight: 500;
                font-size: 1rem;
            }

                .contact-item a:hover {
                    color: #93c5fd;
                }

            .contact-item p {
                color: #9ca3af;
                font-size: 0.95rem;
            }

        /* Button */
        .btn {
            background: linear-gradient(135deg, #60a5fa, #a78bfa);
            color: #ffffff;
            border: none;
            padding: 16px 32px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin-top: 32px;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px -5px rgba(96, 165, 250, 0.4);
            }

        /* Footer */
        footer {
            background: #1a1a2e;
            border-top: 1px solid #2d3748;
            padding: 48px 0;
            text-align: center;
            margin-top: 80px;
        }

            footer p {
                color: #9ca3af;
                font-size: 0.9rem;
            }
    </style>

</head>
<body>
    <header>
        <div class="container">
            <h1>Matter Academy</h1>
            <p>Shaping Tomorrow's Innovators Through Advanced Online Education</p>
        </div>
    </header>

    @* <nav>
        <div class="container">
            <ul>
                <li><a href="#about">About</a></li>
                <li><a href="#courses">Courses</a></li>
                <li><a href="#features">Features</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </div>
    </nav> *@

    <main>
        <div class="container">
            <!-- About Section -->
            <section id="about">
                <div class="section-header">
                    <h2>About Matter Academy</h2>
                    <p>Pioneering the future of online education through innovation</p>
                </div>
                <div class="card">
                    <div class="card-content">
                        <p>We are pioneering the future of online education through cutting-edge technology and innovative teaching methodologies. Our platform provides students worldwide with access to premium courses and interactive learning experiences.</p>
                        <p>Join thousands of students who have transformed their careers through our expertly crafted curriculum and personalized learning paths.</p>
                    </div>
                </div>
            </section>

            <!-- Courses Section -->
            <section id="courses">
                <div class="section-header">
                    <h2>Available Courses</h2>
                    <p>Comprehensive programs designed for the modern learner</p>
                </div>

                <div class="grid-2">
                    <div class="grid-item">
                        <h3>Computer Science</h3>
                        <p>Master algorithms, data structures, and software development with hands-on projects and real-world applications.</p>
                    </div>
                    <div class="grid-item">
                        <h3>Information Technology</h3>
                        <p>Learn system administration, networking, and cybersecurity fundamentals for modern IT infrastructure.</p>
                    </div>
                    <div class="grid-item">
                        <h3>Business Administration</h3>
                        <p>Develop leadership skills, strategic thinking, and business acumen for executive-level positions.</p>
                    </div>
                    <div class="grid-item">
                        <h3>Artificial Intelligence</h3>
                        <p>Dive deep into machine learning, neural networks, and AI applications in various industries.</p>
                    </div>
                    <div class="grid-item">
                        <h3>Data Science</h3>
                        <p>Analyze complex datasets and create meaningful insights from data using advanced statistical methods.</p>
                    </div>
                    <div class="grid-item">
                        <h3>Web Development</h3>
                        <p>Build responsive websites and modern web applications using the latest technologies and frameworks.</p>
                    </div>
                </div>

                <div style="text-align: center; margin-top:20px;">
                    <a class="btn" asp-action="Create" asp-controller="ApplyCourse">Join a Course</a>
            
                </div>

            </section>

            <!-- Features Section -->
            <section id="features">
                <div class="section-header">
                    <h2>Why Choose Matter Academy?</h2>
                    <p>Everything you need for successful online learning</p>
                </div>

                <div class="grid-2">
                    <div class="feature-item">
                        <h3>🎓 Expert Instructors</h3>
                        <p>Learn from industry professionals and academic leaders with real-world experience</p>
                    </div>
                    <div class="feature-item">
                        <h3>📱 Mobile Learning</h3>
                        <p>Access courses anytime, anywhere on any device with our responsive platform</p>
                    </div>
                    <div class="feature-item">
                        <h3>🏆 Certification</h3>
                        <p>Earn recognized certificates to advance your career and validate your skills</p>
                    </div>
                    <div class="feature-item">
                        <h3>🤝 Community</h3>
                        <p>Connect with peers and build professional networks through our learning community</p>
                    </div>
                </div>
            </section>

            <!-- Contact Section -->
            <section id="contact">
                <div class="section-header">
                    <h2>Get In Touch</h2>
                    <p>Ready to start your learning journey? We're here to help</p>
                </div>

                <div class="grid-3">
                    <div class="contact-item">
                        <h3>📧 Email Support</h3>
                        <a href="mailto:support@matteracademy.com">support@matteracademy.com</a>
                    </div>
                    <div class="contact-item">
                        <h3>📞 Phone Support</h3>
                        <a href="tel:+201273201805">+20 127 320 1805</a>
                    </div>
                    <div class="contact-item">
                        <h3>🌐 Online Chat</h3>
                        <p>Available 24/7 for instant help and support</p>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2025 Matter Academy. All Rights Reserved. | Empowering Education Through Innovation</p>
        </div>
    </footer>

    <script>
        // Smooth scrolling for navigation links
        document.querySelectorAll('nav a').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetSection = document.querySelector(targetId);

                if (targetSection) {
                    targetSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add scroll effect to navigation
        let lastScrollY = window.scrollY;
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 100) {
                nav.style.background = 'rgba(26, 26, 46, 0.95)';
            } else {
                nav.style.background = '#1a1a2e';
            }
        });
    </script>
</body>
</html>