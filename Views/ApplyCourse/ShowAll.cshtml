@model IEnumerable<university_Project.ViewModel.ApplayCourseViewModel>

@{
    ViewData["Title"] = "Show All Applications Request";
}



<div class="container mt-4">
    <h2 class="mb-4 text-primary">
        <i class="bi bi-list-check me-2"></i> Show All Applications
    </h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            No records found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle shadow-sm">
                <thead class="bg-primary text-white">
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.ID)</th>
                        <th>@Html.DisplayNameFor(m => m.Name)</th>
                        <th>@Html.DisplayNameFor(m => m.Address)</th>
                        <th>@Html.DisplayNameFor(m => m.course.Name)</th>
                        <th>@Html.DisplayNameFor(m => m.Department.Name)</th>
                        <th>@Html.DisplayNameFor(m => m.DateOfBirth)</th>
                        <th>@Html.DisplayNameFor(m => m.Gender)</th>
                        <th>@Html.DisplayNameFor(m => m.RegistrationDate)</th>
                        <th>@Html.DisplayNameFor(m => m.Email)</th>
                        <th>@Html.DisplayNameFor(m => m.Phone)</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ID</td>
                            <td>@item.Name</td>
                            <td>@item.Address</td>
                            <td>@item.course?.Name</td>
                            <td>@item.Department?.Name</td>
                            <td>@item.DateOfBirth.ToShortDateString()</td>
                            <td>@item.Gender</td>
                            <td>@item.RegistrationDate.ToShortDateString()</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.ID"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.ID"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Are you sure you want to delete this record?');">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
